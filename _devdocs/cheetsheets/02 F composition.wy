
    import fptk * , require fptk *

; Overview ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\ {{{1

    .
    -> ->>
    p:
    lmap

    func                ; with args
    partial pflip flip  
    fn fm f>

    . obj [1] "key" attr (.method)
    get cut slice
    getattr getattrm

; _____________________________________________________________________________/ }}}1

    obj.attr
    (obj.meth arg1)
    (.meth obj arg1)
    (. obj meth arg1)
    . obj [1] ["key"] attr (meth arg1)

    ->  obj (get #_ slot 0)
            (flip nth #_ slot 0)
            .attr
            (getattr #_ slot "attr")
            (getattrm #_ slot .attr)
            (.meth #_ slot arg1)
            func
            (div #_ slot 3)
            : (partial div 3) #_ slot
            : (partial lmap plus) #_ slot
            : (p> abs neg) #_ slot
            : (fm (+ %1 %2 %3)) #_ slot arg2 arg3
            (->  #_ slot abs)           ; essentially achieves nothing
            (->> #_ slot abs)           ; yes, will work as ->>, which is good

    ->> obj : (fm (get it 0))           ; get is macro, can't use flip with it
            (nth 0 #_ slot)
            .attr
            (flip getattr "attr" #_ slot)
            : (fm (getattrm it .attr))  ; getattrm is macro, can't use flip with it
            (.meth arg1 #_ slot)        ; same as (arg1.meth #_ slot), so no use
            func
            (div 3 #_ slot)
            (partial div 3 #_ slot)
            (lmap plus #_ slot)
            (p> abs neg) #_ slot
            (fm (+ %1 %2 %3)) arg1 arg2 #_ slot
            (->  xs #_ slot)            ; doesn't seem usable
            (->> xs #_ slot)            ; doesn't seem usable

    p:      (nth 0 #_ slot)                 
            (flip getattr "attr" #_ slot)   
            .attr (.meth #_ slot arg1)
            func (func arg1 #_ slot) (flip func arg2 #_ slot)
            (lmap abs #_ slot)
            ((p> abs neg) #_ slot)
            (fn [x y] (sconcat x "2")) (fm (sconcat it "3")) (f> (sconcat it "3")) 

